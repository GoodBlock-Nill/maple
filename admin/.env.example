# Supabase 프로젝트 URL (클라이언트에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명(anon) 키 (클라이언트에 노출됨, RLS 로 보호)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버 전용, 절대 클라이언트에 노출 금지)
# 회원 제재 등 Auth Admin API 에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# 사용자 사이트 URL. 게시글/문의 "원문 보기" 링크에 쓴다.
NEXT_PUBLIC_CLIENT_SITE_URL=https://maple-web-sigma.vercel.app

# 관리자 사이트 자기 URL. 초대 메일·비밀번호 재설정 메일의 redirectTo 에 쓴다.
# 값이 틀리면 초대 링크가 사용자 사이트로 가서 초대 수락이 불가능해진다.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# 첫 슈퍼어드민 생성 스크립트(scripts/bootstrap-admin.mjs) 전용. 운영 배포 env 에는 넣지 않는다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# 사용자 사이트 캐시 무효화 공유 시크릿.
# 사용자 사이트(저장소 루트)의 .env.local · Vercel 환경 변수와 **같은 값**이어야 한다.
# 비어 있으면 관리자 쓰기는 그대로 성공하고, 사용자 사이트는 태그 수명(목록 60초 ·
# 정적 300초)만큼 늦게 반영된다.
REVALIDATE_SECRET=

# 캐시 무효화를 보낼 사용자 사이트 주소(서버 전용, 없으면 NEXT_PUBLIC_CLIENT_SITE_URL 사용).
# 로컬 개발에서는 반드시 로컬 서버를 가리킨다 — 안 그러면 운영 캐시를 태운다.
CLIENT_SITE_URL=http://localhost:3000

# 로컬 개발 편의: 로그인 칸을 이 값으로 미리 채운다.
# 운영(Vercel)에는 절대 설정하지 않는다 — 공개 로그인 페이지 HTML 에 그대로 실린다.
ADMIN_LOGIN_PREFILL_EMAIL=
ADMIN_LOGIN_PREFILL_PASSWORD=
