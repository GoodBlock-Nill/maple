# Supabase 프로젝트 URL (클라이언트에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명(anon) 키 (클라이언트에 노출됨, RLS 로 보호)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버 전용, 절대 클라이언트에 노출 금지)
# 관리자 초대(auth.admin.inviteUserByEmail) · 회원 제재 등 admin API 에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# 사용자 사이트 URL. 게시글/문의 "원문 보기" 링크에 쓴다.
NEXT_PUBLIC_CLIENT_SITE_URL=https://maple-web-sigma.vercel.app

# 관리자 사이트 자기 URL. 초대·비밀번호 재설정 메일의 redirectTo 에 쓴다.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# 첫 관리자 생성 스크립트(scripts/bootstrap-admin.mjs) 전용. 운영 배포 env 에는 넣지 않는다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
