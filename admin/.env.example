# Supabase 프로젝트 URL (클라이언트에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명(anon) 키 (클라이언트에 노출됨, RLS 로 보호)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버 전용, 절대 클라이언트에 노출 금지)
# 회원 제재 등 Auth Admin API 에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# 사용자 사이트 URL. 게시글/문의 "원문 보기" 링크에 쓴다.
NEXT_PUBLIC_CLIENT_SITE_URL=https://maple-web-sigma.vercel.app

# 관리자 사이트 자기 URL. 간편로그인 콜백·비밀번호 재설정 메일의 redirectTo 에 쓴다.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# 간편로그인 동작 방식 — stub | oauth (비워 두면 stub). 사용자 사이트와 같은 이름이다.
#   stub  : 구글·카카오·네이버 버튼이 "실 OAuth 연동 후 사용" 안내만 돌려준다.
#           관리자 앱에는 스텁 로그인이 없다 — 스텁은 없는 계정을 즉시 만들어 주는데
#           그걸 관리자에 두면 아무나 관리자 후보 계정을 찍어낼 수 있다.
#   oauth : Supabase Auth 의 구글·카카오 제공자로 실제 로그인한다(네이버는 미지원, §5 참고).
# TODO(auth): 개발팀 실 OAuth 연동이 끝나면 배포 환경에서 oauth 로 바꾼다.
SOCIAL_LOGIN_MODE=stub

# 이메일·비밀번호 로그인 섹션 노출. disabled 일 때만 숨긴다(그 외 값·미설정은 노출).
# 실 OAuth 로 전환이 끝나면 배포 환경에서 disabled 로 닫는다.
ADMIN_PASSWORD_LOGIN=

# 첫 관리자 생성 스크립트(scripts/bootstrap-admin.mjs) 전용. 운영 배포 env 에는 넣지 않는다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# 사용자 사이트 캐시 무효화 공유 시크릿.
# 사용자 사이트(저장소 루트)의 .env.local · Vercel 환경 변수와 **같은 값**이어야 한다.
# 비어 있으면 관리자 쓰기는 그대로 성공하고, 사용자 사이트는 태그 수명(목록 60초 ·
# 정적 300초)만큼 늦게 반영된다.
REVALIDATE_SECRET=

# 캐시 무효화를 보낼 사용자 사이트 주소(서버 전용, 없으면 NEXT_PUBLIC_CLIENT_SITE_URL 사용).
# 로컬 개발에서는 반드시 로컬 서버를 가리킨다 — 안 그러면 운영 캐시를 태운다.
CLIENT_SITE_URL=http://localhost:3000
