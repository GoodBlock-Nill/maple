# Supabase 프로젝트 URL (클라이언트에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명(anon) 키 (클라이언트에 노출됨, RLS로 보호)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키 (서버 전용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 기본 URL (메타데이터, 리다이렉트 등에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 간편로그인 동작 방식 — stub | oauth (비워 두면 stub)
#   stub  : 버튼을 누르면 제공자를 거치지 않고 즉시 로그인된다(개발/시연용).
#   oauth : 구글·카카오·네이버 실제 OAuth. 아직 미구현이라 "준비 중" 안내가 뜬다.
# TODO(auth): 개발팀 실 OAuth 연동이 끝나면 배포 환경에서 oauth 로 바꾼다.
SOCIAL_LOGIN_MODE=stub

# 메이플스토리 월드 UID·프로필 코드 입력 노출. 추후 요청 시 true
NEXT_PUBLIC_FEATURE_MSW_ACCOUNT_FIELDS=false

# 가이드(확률형 아이템 정보) "서비스 준비 중" 화면 표시. 기본 OFF(실제 화면 노출). 오픈 전 막고 싶을 때만 true
NEXT_PUBLIC_FEATURE_GUIDE_COMING_SOON=false

# 랭킹 "서비스 준비 중" 화면 표시. 기본 OFF(실제 화면 노출). 오픈 전 막고 싶을 때만 true
NEXT_PUBLIC_FEATURE_RANKING_COMING_SOON=false
